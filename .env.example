# Copy to .env and fill in secrets:
#   cp .env.example .env
#
# Load before starting workers:
#   set -a && source .env && set +a

# --- Required for live probe worker ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Postgres (MAR) ---
DATABASE_URL=postgresql+asyncpg://rca:rca@127.0.0.1:5432/rca_mar

# --- Neo4j (KG) ---
KG_URI=bolt://127.0.0.1:7687
KG_USERNAME=neo4j
KG_PASSWORD=rca-dev-password
KG_DATABASE=neo4j
NEO4J_PASSWORD=rca-dev-password

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
PROBE_TASK_QUEUE=rca-probes

# --- Probe / MCP ---
PROBE_USE_POSTGRES=1
MCP_HOST_URL=http://127.0.0.1:8100/mcp
MCP_HOST_PORT=8100

# --- Simulators ---
HISTORIAN_SIM_URL=http://127.0.0.1:8001
CMMS_SIM_URL=http://127.0.0.1:8002
DOCUMENT_SIM_URL=http://127.0.0.1:8004

# --- Live test gates (optional) ---
# RCA_STACK=1
# RCA_DB=1
